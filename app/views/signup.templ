package views 

import "scifi-search/app/utils"

// ------------------------------------------------------------------------------------------------
// Sign Up Content
// ------------------------------------------------------------------------------------------------
templ signUpContent(errorMessage string, translator utils.Translator) {
	@Header()
	<main>
		<div class="only-form-content">
			<div class="centered-container">
				<form id="signup-form" action="/signup" method="POST">
					<div class="form-name-container">
						<input type="text" id="name" placeholder={ translator("name") } name="name" required/>
					</div>
					<div class="form-surname-container">
						<input type="text" id="surname" placeholder={ translator("surname") } name="surname" required/>
					</div>
					<div class="form-email-container">
						<input type="email" id="email" placeholder={ translator("email") } name="email" required/>
					</div>
					<div class="form-password-container">
						<input type="password" id="password" placeholder={ translator("password") } name="password" required/>
					</div>
					<div class="form-submit-container">
						<button class="submit-button" type="submit">{ translator("sign-up") }</button>
					</div>
				</form>
			</div>
		</div>
	</main>
}

// ------------------------------------------------------------------------------------------------
// Sign Up Page
// ------------------------------------------------------------------------------------------------
templ SignUpPage(errorMessage string, translator utils.Translator) {
	@Layout(translator("sign-up"), translator, func() templ.Component {
		return signUpContent(errorMessage, translator)
	})
}

