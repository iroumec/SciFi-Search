templ ManageFundingPage(fundings []map[string]any, totalFundings int, authorizationLevel int, translator languages.Translator) {
	@Layout("Manage projects", translator,
		func() templ.Component { return Header(true, authorizationLevel, translator) },
		func() templ.Component { return manageFundingContent(fundings, totalFundings, translator) },
	)
}
