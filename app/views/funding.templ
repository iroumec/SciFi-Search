package views

import (
	"container/list"
	"scifi-search/app/languages"
	"scifi-search/app/utils/converters"
)

// ------------------------------------------------------------------------------------------------
// ------------------------------------ Modal Component -------------------------------------------
// ------------------------------------------------------------------------------------------------
templ addFundingModal(documentTypes *list.List, documentAreas *list.List, documentBasedOn *list.List, documentGrantors *list.List, documentCurrencies *list.List, translator languages.Translator) {
	<div id="add-funding-modal" class="modal-overlay" hidden>
		<div class="modal-content">
			<div class="modal-header">
				<h2>{ translator("funding.new") }</h2>
				<button class="close-button" type="button">&times;</button>
			</div>
			<form
				id="funding-form"
				hx-post="/funding"
				hx-target="#funding-list"
				hx-swap="innerHTML"
			>
				<div class="form-inputs">
					<label for="name">{ translator("name") }</label>
					<input type="text" id="name" name="name" required/>
					<label for="type">{ translator("type") }</label>
					<input type="text" id="type" name="type" list="types" required/>
					<label for="first-area">{ translator("areas") }</label>
					<input type="text" id="first-area" placeholder={ translator("first-area") } name="first-area" list="areas" required/>
					<input type="text" id="second-area" placeholder={ translator("second-area") } name="second-area" list="areas"/>
					<label for="link">{ translator("link") }</label>
					<input type="url" id="link" name="link"/>
					<label for="description">{ translator("description") }</label>
					<input type="text" id="description" name="description"/>
					<div class="double-input">
						<div class="labeled-input">
							<label for="based-on">{ translator("based_on") }</label>
							<input type="text" id="based-on" name="based-on" list="based-on"/>
						</div>
						<div class="labeled-input">
							<label for="grantor">{ translator("grantor") }</label>
							<input type="text" id="grantor" name="grantor" list="grantors"/>
						</div>
					</div>
					<div class="double-input">
						<div class="labeled-input">
							<label for="currency">{ translator("currency") }</label>
							<input type="text" id="currency" name="currency" required list="currencies"/>
						</div>
						<div class="labeled-input">
							<label for="amount">{ translator("amount") }</label>
							<input type="text" id="amount" placeholder="min - max" name="amount" required/>
						</div>
					</div>
					<label for="deadline">{ translator("deadline") }</label>
					<input type="date" id="deadline" name="deadline" required/>
					@datalist("types", documentTypes)
					@datalist("areas", documentAreas)
					@datalist("based-on", documentBasedOn)
					@datalist("grantors", documentGrantors)
					@datalist("currencies", documentCurrencies)
				</div>
				<div class="modal-footer">
					<button id="cancel-button" type="button" class="scifi-button secondary">
						{ translator("cancel") }
					</button>
					<button type="submit" class="scifi-button">
						{ translator("submit") }
					</button>
				</div>
			</form>
		</div>
	</div>
	<script>
		(function () {
			const modal = document.getElementById("add-funding-modal");
			const closeBtn = modal.querySelector(".close-button");
			const cancelBtn = document.getElementById("cancel-button");
			const form = document.getElementById("funding-form");

			window.openAddFundingModal = function () {
				modal.hidden = false;
			};

			function closeModal() {
				modal.hidden = true;
				form.reset();
			}

			closeBtn.addEventListener("click", closeModal);
			cancelBtn.addEventListener("click", closeModal);

			modal.addEventListener("click", function (event) {
				if (event.target === modal) {
					closeModal();
				}
			});

			document.body.addEventListener("htmx:afterRequest", (e) => {
				if (e.target === form && e.detail.successful) {
					closeModal();
				}
			})
		})();
	</script>
}

templ datalist(name string, options *list.List) {
	<datalist id={ name }>
		for e := options.Front(); e != nil; e = e.Next() {
			<option value={ e.Value.(string) }></option>
		}
	</datalist>
}

// ------------------------------------------------------------------------------------------------
// ------------------------------------ Successful Upload -----------------------------------------
// ------------------------------------------------------------------------------------------------
templ fundingAddedContent(translator languages.Translator) {
	<main>
		<div class="sucessful-signup-container">
			<h1>{ translator("funding.added") }</h1>
			<button class="header-button" onclick="window.location.href='/'">{ translator("redirect.main_page") }</button>
			<button class="header-button" onclick="window.location.href='/funding'">{ translator("funding.add_another") }</button>
		</div>
	</main>
}

templ FundingAddedPage(translator languages.Translator) {
	@Layout(translator("funding.added"), translator,
		func() templ.Component { return Header(true, 0, translator) },
		func() templ.Component { return fundingAddedContent(translator) },
	)
}

// ------------------------------------------------------------------------------------------------
// ------------------------------------ Manage Funding --------------------------------------------
// ------------------------------------------------------------------------------------------------
templ manageFundingContent(fundings []map[string]any, totalFundings int, documentTypes *list.List, documentAreas *list.List, documentBasedOn *list.List, documentGrantors *list.List, documentCurrencies *list.List, translator languages.Translator) {
	<div class="centered-box-content">
		<div id="left"></div>
		<div id="manage-funding-content">
			<div id="funding-title">Manage projects </div>
			<div id="funding-content">
				<div id="funding-list">
					@FundingList(fundings, 1, totalFundings, translator)
				</div>
			</div>
			<div id="funding-buttons">
				<button class="scifi-button" type="button" onclick="openAddFundingModal()">
					Add new
				</button>
			</div>
		</div>
		<div id="right"></div>
		
		@addFundingModal(documentTypes, documentAreas, documentBasedOn, documentGrantors, documentCurrencies, translator)
	</div>
}

templ FundingList(fundings []map[string]any, page int, totalFundings int, translator languages.Translator) {
	<div class="documents-section">
		for i := 0; i < len(fundings); i++ {
			<div class="result">
				@documentItem(fundings[i], "funding-item")
				<div class="funding-item-buttons">
					<button
						class="funding-item-button edit-button"
					></button>
					<button
						class="funding-item-button delete-button"
						hx-delete={ "/funding/" + converters.ToString(fundings[i]["id"]) }
						hx-target="closest .result"
						hx-swap="outerHTML"
						hx-confirm="¿Desea eliminar el funding? ¡Esta decisión no puede deshacerse!"
						type="button"
					></button>
				</div>
			</div>
		}
	</div>
	@pagination(totalFundings, page, "/funding/update-items", "", "#funding-list")
}

templ ManageFundingPage(fundings []map[string]any, totalFundings int, authorizationLevel int, documentTypes *list.List, documentAreas *list.List, documentBasedOn *list.List, documentGrantors *list.List, documentCurrencies *list.List, translator languages.Translator) {
	@Layout("Manage projects", translator,
		func() templ.Component { return Header(true, authorizationLevel, translator) },
		func() templ.Component {
			return manageFundingContent(fundings, totalFundings, documentTypes, documentAreas, documentBasedOn, documentGrantors, documentCurrencies, translator)
		},
	)
}
