package views

import (
	"container/list"
	"scifi-search/app/languages"
	"scifi-search/app/utils/converters"
)

// ------------------------------------------------------------------------------------------------
// ------------------------------------ Modal Component -------------------------------------------
// ------------------------------------------------------------------------------------------------
templ FundingModal(mode string, document map[string]any, documentTypes *list.List, documentAreas *list.List, documentBasedOn *list.List, documentGrantors *list.List, documentCurrencies *list.List, translator languages.Translator) {
	<div class="modal-overlay">
		<div class="modal-content">
			<div class="modal-header">
				<h2>
					if mode == "edit" {
						{ translator("funding.edit") }
					} else {
						{ translator("funding.new") }
					}
				</h2>
				<button class="close-button" type="button" onclick="this.closest('.modal-overlay').remove()">&times;</button>
			</div>
			@fundingForm(document, mode, documentTypes, documentAreas, documentBasedOn, documentGrantors, documentCurrencies, translator)
		</div>
	</div>
	<script>
		(function () {
			document.addEventListener("click", (e) => {
				if (e.target.classList.contains("modal-overlay")) {
					e.target.remove()
				}
			})
		})();
	</script>
}

templ fundingForm(document map[string]any, mode string, documentTypes *list.List, documentAreas *list.List, documentBasedOn *list.List, documentGrantors *list.List, documentCurrencies *list.List, translator languages.Translator) {
	<form
		id="funding-form"
		if mode == "edit" {
			hx-put={ "/funding/" + document["id"].(string) }
		} else {
			hx-post="/funding"
		}
		hx-target="#funding-list"
		hx-swap="innerHTML"
		hx-on="htmx:afterRequest: if(event.detail.successful) document.getElementById('modal-root').innerHTML=''"
	>
		<div class="form-inputs">

			@labeledInput("name", translator("name"), "text", "", "", document["Name"], true)
			@labeledInput("type", translator("type"), "text", "types", "", document["Type"], true)

			<div class="labeled-input">
				<label for="main-area">{ translator("areas") }</label>
				<input
					type="text"
					id="main-area"
					placeholder={ translator("main-area") }
					name="main-area"
					list="areas"
					required
					if document["Main area"] != nil && document["Main area"].(string) != "" {
						value={ document["Main area"].(string) }
					}
				/>
				<input
					type="text"
					id="secondary-area"
					placeholder={ translator("secondary-area") }
					name="secondary-area"
					list="areas"
					if document["Secondary area"] != nil && document["Secondary area"].(string) != "" {
						value={ document["Secondary area"].(string) }
					}
				/>
			</div>

			@labeledInput("link", translator("link"), "url", "", "", document["Link"], false)
			@labeledInput("description", translator("description"), "text", "", "", document["Description"], false)
			
			<div class="double-input">
				@labeledInput("based-on", translator("based_on"), "text", "based-on", "", document["Based on"], false)
				@labeledInput("grantor", translator("grantor"), "text", "grantors", "", document["Grantor"], false)
			</div>

			<div class="double-input">
				@labeledInput("currency", translator("currency"), "text", "currencies", "", document["Currency"], true)
				@labeledInput("amount", translator("amount"), "text", "", "min - max", document["Amount"], true)
			</div>

			@labeledInput("deadline", translator("deadline"), "date", "", "", document["Deadline"], true)
			
			
			@datalist("types", documentTypes)
			@datalist("areas", documentAreas)
			@datalist("based-on", documentBasedOn)
			@datalist("grantors", documentGrantors)
			@datalist("currencies", documentCurrencies)
		</div>
		<div class="modal-footer">
			<button id="cancel-button" type="button" class="scifi-button secondary" onclick="this.closest('.modal-overlay').remove()">
				{ translator("cancel") }
			</button>
			<button type="submit" class="scifi-button">
				{ translator("submit") }
			</button>
		</div>
	</form>
}

templ labeledInput(input string, label string, inputType string, list string, placeholder string, inputValue any, required bool) {
	{{
		if inputValue == nil {
			inputValue = ""
		}
		inputString := inputValue.(string)
	}}
	<div class="labeled-input">
		<label for={ input }>{ label }</label>
		<input
			type={ inputType }
			id={ input }
			name={ input }
			if list != "" {
				list={ list }
			}
			if placeholder != "" {
				placeholder={ placeholder }
			}
			if inputValue != "" {
				value={ inputString }
			}
			if required {
				required
			}
		/>
	</div>
}

templ datalist(name string, options *list.List) {
	<datalist id={ name }>
		for e := options.Front(); e != nil; e = e.Next() {
			<option value={ e.Value.(string) }></option>
		}
	</datalist>
}

// ------------------------------------------------------------------------------------------------
// ------------------------------------ Successful Upload -----------------------------------------
// ------------------------------------------------------------------------------------------------
templ fundingAddedContent(translator languages.Translator) {
	<main>
		<div class="sucessful-signup-container">
			<h1>{ translator("funding.added") }</h1>
			<button class="header-button" onclick="window.location.href='/'">{ translator("redirect.main_page") }</button>
			<button class="header-button" onclick="window.location.href='/funding'">{ translator("funding.add_another") }</button>
		</div>
	</main>
}

templ FundingAddedPage(translator languages.Translator) {
	@Layout(translator("funding.added"), translator,
		func() templ.Component { return Header(true, 0, translator) },
		func() templ.Component { return fundingAddedContent(translator) },
	)
}

// ------------------------------------------------------------------------------------------------
// ------------------------------------ Manage Funding --------------------------------------------
// ------------------------------------------------------------------------------------------------
templ manageFundingContent(
	fundings []map[string]any,
	totalFundings int,
	documentTypes *list.List,
	documentAreas *list.List,
	documentBasedOn *list.List,
	documentGrantors *list.List,
	documentCurrencies *list.List,
	translator languages.Translator,
) {
	<div class="centered-box-content">
		<div id="left"></div>
		<div id="manage-funding-content">
			<div id="funding-title">Manage projects</div>
			<div id="funding-content">
				<div id="funding-list">
					@FundingList(fundings, 1, totalFundings, translator)
				</div>
			</div>
			<div id="funding-buttons">
				@fundingActions(translator)
			</div>
		</div>
		<div id="right"></div>
		<div id="modal-root"></div>
	</div>
}

templ fundingActions(translator languages.Translator) {
	<div class="funding-actions">
		<button
			class="scifi-button"
			type="button"
			hx-get="/funding/open-add-new"
			hx-target="#modal-root"
			hx-swap="innerHTML"
		>
			Add new
		</button>
		@exportButton(translator)
	</div>
}

templ FundingList(fundings []map[string]any, page int, totalFundings int, translator languages.Translator) {
	<div class="documents-section">
		for i := 0; i < len(fundings); i++ {
			<div class="result">
				@documentItem(fundings[i], "funding-item")
				<div class="funding-item-buttons">
					<button
						class="funding-item-button edit-button"
						hx-get={ "/funding/open-edit/" + converters.ToString(fundings[i]["id"]) }
						hx-target="#modal-root"
						hx-swap="innerHTML"
					></button>
					<button
						class="funding-item-button delete-button"
						hx-delete={ "/funding/" + converters.ToString(fundings[i]["id"]) }
						hx-target="closest .result"
						hx-swap="outerHTML"
						hx-confirm="¿Desea eliminar el funding? ¡Esta decisión no puede deshacerse!"
						type="button"
					></button>
				</div>
			</div>
		}
	</div>
	@pagination(totalFundings, page, "/funding/update-items", "", "#funding-list")
}

templ ManageFundingPage(fundings []map[string]any, totalFundings int, authorizationLevel int, documentTypes *list.List, documentAreas *list.List, documentBasedOn *list.List, documentGrantors *list.List, documentCurrencies *list.List, translator languages.Translator) {
	@Layout("Manage projects", translator,
		func() templ.Component { return Header(true, authorizationLevel, translator) },
		func() templ.Component {
			return manageFundingContent(fundings, totalFundings, documentTypes, documentAreas, documentBasedOn, documentGrantors, documentCurrencies, translator)
		},
	)
}
