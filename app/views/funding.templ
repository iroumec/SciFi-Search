package views

import (
	"scifi-search/app/database"
	"scifi-search/app/languages"
	"scifi-search/app/utils/converters"
)

// ------------------------------------------------------------------------------------------------
// ------------------------------------------ Upload ----------------------------------------------
// ------------------------------------------------------------------------------------------------
templ addFundingContent(translator languages.Translator) {
	<div class="only-form-content">
		<div class="centered-container">
			<form id="funding-form" action="/funding" method="POST">
				<div id="form-inputs">
					<input type="text" placeholder={ translator("name") } name="name" required/>
					<input type="text" placeholder={ translator("type") } name="type" required/>
					<input type="text" placeholder={ translator("first-area") } name="first-area" required/>
					<input type="text" placeholder={ translator("second-area") } name="second-area"/>
					<input type="link" placeholder={ translator("link") } name="link"/>
					<input type="text" placeholder={ translator("description") } name="description"/>
					<input type="text" placeholder="Basado en (Pais)" name="based-on"/>
					<input type="text" placeholder="Entidad otorgante" name="grantor"/>
					<input type="date" placeholder="Deadline" name="deadline" required/>
				</div>
				<button class="scifi-button" type="submit">{ translator("submit") }</button>
			</form>
		</div>
	</div>
}

templ AddFundingPage(translator languages.Translator) {
	@Layout(translator("funding.new"), translator,
		func() templ.Component { return Header(true, true, translator) },
		func() templ.Component { return addFundingContent(translator) },
	)
}

// ------------------------------------------------------------------------------------------------
// ------------------------------------ Modal Component -------------------------------------------
// ------------------------------------------------------------------------------------------------
templ addFundingModal(translator languages.Translator) {
	<!-- Modal Overlay -->
	<div
		x-show="open"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0"
		x-transition:enter-end="opacity-100"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100"
		x-transition:leave-end="opacity-0"
		@click="open = false"
		class="modal-overlay"
		style="display: none;"
		x-cloak
	>
		<!-- Modal Content -->
		<div
			@click.stop
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 transform translate-y-4 scale-95"
			x-transition:enter-end="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave="transition ease-in duration-200"
			x-transition:leave-start="opacity-100 transform translate-y-0 scale-100"
			x-transition:leave-end="opacity-0 transform translate-y-4 scale-95"
			class="modal-content"
		>
			<div class="modal-header">
				<h2>{ translator("funding.new") }</h2>
				<button @click="open = false" class="close-button" type="button">&times;</button>
			</div>
			<form
				hx-post="/funding"
				hx-target="#funding-list"
				hx-swap="beforeend"
				@htmx:after-request="if($event.detail.successful) { open = false; $refs.fundingForm.reset(); }"
				x-ref="fundingForm"
			>
				<div class="form-inputs">
					<input type="text" placeholder={ translator("name") } name="name" required/>
					<input type="text" placeholder={ translator("type") } name="type" required/>
					<input type="text" placeholder={ translator("first-area") } name="first-area" required/>
					<input type="text" placeholder={ translator("second-area") } name="second-area"/>
					<input type="url" placeholder={ translator("link") } name="link"/>
					<input type="text" placeholder={ translator("description") } name="description"/>
					<input type="text" placeholder="Basado en (País)" name="based-on"/>
					<input type="text" placeholder="Entidad otorgante" name="grantor"/>
					<input type="date" name="deadline" required/>
				</div>
				<div class="modal-footer">
					<button type="button" @click="open = false" class="scifi-button secondary">
						{ translator("cancel") }
					</button>
					<button type="submit" class="scifi-button">
						{ translator("submit") }
					</button>
				</div>
			</form>
		</div>
	</div>
}

// ------------------------------------------------------------------------------------------------
// ------------------------------------ Successful Upload -----------------------------------------
// ------------------------------------------------------------------------------------------------
templ fundingAddedContent(translator languages.Translator) {
	<main>
		<div class="sucessful-signup-container">
			<h1>{ translator("funding.added") }</h1>
			<button class="header-button" onclick="window.location.href='/'">{ translator("redirect.main_page") }</button>
			<button class="header-button" onclick="window.location.href='/funding'">{ translator("funding.add_another") }</button>
		</div>
	</main>
}

templ FundingAddedPage(translator languages.Translator) {
	@Layout(translator("funding.added"), translator,
		func() templ.Component { return Header(true, true, translator) },
		func() templ.Component { return fundingAddedContent(translator) },
	)
}

// ------------------------------------------------------------------------------------------------
// ------------------------------------ Manage Funding --------------------------------------------
// ------------------------------------------------------------------------------------------------
templ manageFundingContent(fundings []database.Document, translator languages.Translator) {
	<div class="centered-box-content" x-data="{ open: false }">
		<div id="left"></div>
		<div id="manage-funding-content">
			<p>Manage projects</p>
			<div id="funding-list">
				@fundingItems(fundings, translator)
			</div>
			<button class="scifi-button" @click="open = true" type="button">
				Add new
			</button>
		</div>
		<div id="right"></div>
		<!-- Modal Component -->
		@addFundingModal(translator)
	</div>
}

templ ManageFundingPage(fundings []database.Document, translator languages.Translator) {
	@Layout("Manage projects", translator,
		func() templ.Component { return Header(true, true, translator) },
		func() templ.Component { return manageFundingContent(fundings, translator) },
	)
}

templ fundingItems(fundings []database.Document, translator languages.Translator) {
	<div class="fundings-list">
		<div class="centered-container">
			<ul id="the-user-list">
				for _, funding := range fundings {
					@fundingItem(funding, translator)
				}
			</ul>
		</div>
	</div>
}

templ fundingItem(funding database.Document, translator languages.Translator) {
	<li id={ "funding-item-" + converters.ToString(funding.ID) }>
		{ funding.Name }
		{ funding.Type }
		<button
			class="delete-button"
			hx-delete={ "/fundings/" + converters.ToString(funding.ID) }
			hx-target={ "#funding-item-" + converters.ToString(funding.ID) }
			hx-swap="outerHTML"
			hx-confirm="¿Desea eliminar el funding? ¡Esta decisión no puede deshacerse!"
			type="submit"
		>
			{ translator("delete") }
		</button>
	</li>
}
