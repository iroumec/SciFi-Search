package views

// ------------------------------------------------------------------------------------------------
// Imports
// ------------------------------------------------------------------------------------------------

import (
	"container/list"
	"scifi-search/app/languages"
	"scifi-search/app/utils/converters"
)

// ------------------------------------------------------------------------------------------------
// Services
// ------------------------------------------------------------------------------------------------
templ ManageFundingPage(
	fundings []map[string]any,
	totalFundings int,
	authorizationLevel int,
	documentTypes *list.List,
	documentAreas *list.List,
	documentBasedOn *list.List,
	documentGrantors *list.List,
	documentCurrencies *list.List,
	translator languages.Translator,
) {
	@Layout(translator("core.manage-fundings"), translator,
		func() templ.Component { return Header(true, authorizationLevel, translator) },
		func() templ.Component {
			return manageFundingContent(
				fundings,
				totalFundings,
				documentTypes,
				documentAreas,
				documentBasedOn,
				documentGrantors,
				documentCurrencies,
				translator,
			)
		},
	)
}

// ------------------------------------------------------------------------------------------------
templ FundingList(
	fundings []map[string]any,
	page int,
	totalFundings int,
	translator languages.Translator,
) {
	<div class="documents-section">
		for i := 0; i < len(fundings); i++ {
			<div class="result">
				@documentItem(fundings[i], "funding-item", translator)
				<div class="funding-item-buttons">
					<button
						class="funding-item-button edit-button"
						hx-get={ "/funding/open-edit/" + converters.ToString(fundings[i]["id"]) }
						hx-target="#modal-root"
						hx-swap="innerHTML"
					></button>
					<button
						class="funding-item-button delete-button"
						hx-delete={ "/funding/" + converters.ToString(fundings[i]["id"]) }
						hx-target="closest .result"
						hx-swap="outerHTML"
						hx-confirm={ translator("messages.funding-deletion-confirmation") }
						type="button"
					></button>
				</div>
			</div>
		}
	</div>
	@pagination(totalFundings, page, "/funding/update-items", "", "#funding-list")
}

// ------------------------------------------------------------------------------------------------
// Functions
// ------------------------------------------------------------------------------------------------
templ manageFundingContent(
	fundings []map[string]any,
	totalFundings int,
	documentTypes *list.List,
	documentAreas *list.List,
	documentBasedOn *list.List,
	documentGrantors *list.List,
	documentCurrencies *list.List,
	translator languages.Translator,
) {
	<div class="centered-box-content">
		<div id="left"></div>
		<div id="manage-funding-content">
			<div id="funding-title">{ translator("core.manage-fundings") }</div>
			<div id="funding-content">
				<div id="funding-list">
					@FundingList(fundings, 1, totalFundings, translator)
				</div>
			</div>
			<div id="funding-buttons">
				@fundingActions(translator)
			</div>
		</div>
		<div id="right"></div>
		@ModalRoot()
	</div>
}

// ------------------------------------------------------------------------------------------------
templ fundingActions(translator languages.Translator) {
	<div class="funding-actions">
		<button
			class="scifi-button"
			type="button"
			hx-get="/funding/open-add-new"
			hx-target="#modal-root"
			hx-swap="innerHTML"
		>
			{ translator("core.add") }
		</button>
		<button
			class="scifi-button"
			type="button"
			hx-get="/documents/open-export-modal"
			hx-target="#modal-root"
			hx-swap="innerHTML"
		>
			{ translator("core.export") }
		</button>
	</div>
}

// ------------------------------------------------------------------------------------------------
