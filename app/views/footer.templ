package views

import (
	"scifi-search/app/languages"
	"scifi-search/app/utils/converters"
)

// ------------------------------------------------------------------------------------------------
// Services
// ------------------------------------------------------------------------------------------------
templ Footer(translator languages.Translator) {
	{{
		var nextLanguage string
		curr := translator("metadata.current-language")
		langs := languages.GetSupportedLanguageCodes()

		for i, lang := range langs {
			if curr == lang {
				nextLanguage = langs[(i+1)%len(langs)]
				break
			}
		}
	}}
	<footer class="footer">
		<div class="clear-top"></div>
		<div class="clear-left"></div>
		<div id="powered-section">
			<p>{ translator("core.powered-by") } </p>
			<div id="images">
				<a href="https://www.meilisearch.com/" target="_blank">
					<img
						src="static/img/logotypes/meilisearch.png"
						alt="Meilisearch Logo"
						class="logo"
					/>
				</a>
				<a href="https://supertokens.com/" target="_blank">
					<img
						src="static/img/logotypes/supertokens.png"
						alt="Supertokens Logo"
						class="logo"
					/>
				</a>
				<a href="https://github.com/minio/minio" target="_blank">
					<img
						src="static/img/logotypes/minio.svg"
						alt="MinIO Logo"
						class="logo"
					/>
				</a>
			</div>
		</div>
		<div id="unicen-logo">
			<a href="https://www.unicen.edu.ar/" target="_blank">
				<img
					src="static/img/logotypes/unicen.png"
					alt="UNICEN Logo"
					id="unicen-logo-img"
				/>
			</a>
		</div>
		<div id="options-section">
			<button
				class="footer-button"
				onclick="window.location.href='/trends'"
			>
				{ translator("core.trends") }
			</button>
			<button
				class="footer-button"
				hx-get="/language"
				hx-swap="none"
				hx-vals={ `{"language":"` + nextLanguage + `"}` }
			>
				{ translator("core.language") +
					": " + converters.UppercaseString(translator("metadata.current-language")) }
			</button>
			<a
				id="github-btn"
				class="footer-button"
				href={ sciFiSearchRepository }
				target="_blank"
			>
				{ translator("core.github-repository") }
			</a>
		</div>
		<div class="clear-right"></div>
	</footer>
}

// ------------------------------------------------------------------------------------------------
