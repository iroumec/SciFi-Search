package views

// ------------------------------------------------------------------------------------------------
// LogIn Content
// ------------------------------------------------------------------------------------------------
templ loginContent(errorMessage string) {
	<main>
		<h2>Iniciar Sesión</h2>
		<form action="/signin" method="POST">
			<input type="email" id="email" name="email" placeholder="Email" required/>
			<br/>
			<input type="password" id="password" name="password" placeholder="Password" required/>
			<br/>
			<button class="bg-scifi text-white border-none cursor-pointer font-bold px-4 py-2" type="submit">Sign in</button>
		</form>
	</main>
	/*tira STRING en rojo, nose xq*/
	if errorMessage != "" {
		<div id="mensaje" style="color:red;">
			{ errorMessage }
		</div>
	}
}

// ------------------------------------------------------------------------------------------------
// LogIn Page
// ------------------------------------------------------------------------------------------------
templ LoginPage(errorMessage string) {
	@Layout("Log-In", false, func() templ.Component {
		return loginContent(errorMessage)
	})
}

// ------------------------------------------------------------------------------------------------
