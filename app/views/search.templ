package views

import (
	"container/list"
	"scifi-search/app/utils"
)

// ------------------------------------------------------------------------------------------------
// Imports
// ------------------------------------------------------------------------------------------------

// ------------------------------------------------------------------------------------------------
// Search Results Content
// ------------------------------------------------------------------------------------------------
templ searchResultsContent(query string, hits []map[string]any, isUserAuthenticated bool, translator utils.Translator, documentTypes *list.List, documentAreas *list.List) {
	@SearchHeader(isUserAuthenticated, translator)
	<main>
		<div class="search-container-grid">
			<div class="top"></div>
			<div class="left"></div>
			<div class="search-content">
				if len(hits) == 0 {
					<div class="message">
						<p>No results found for "{ query }".</p>
					</div>
				} else {
					<div class="message">
						<p>Search results for “{ query }”</p>
					</div>
					<div class="filters">
						@searchFilters(query, documentTypes, documentAreas)
					</div>
					<div id="results">
						@SearchResults(hits)
					</div>
				}
			</div>
			<div class="right"></div>
		</div>
	</main>
}

templ SearchResults(hits []map[string]any) {
	for _, m := range hits {
		<div class="result">
			<a id="title" href={ utils.ToString(m["Link"]) }>{ utils.ToString(m["Nombre"]) }</a>
			<div class="extra-info">
				if utils.ToString(m["Tipo"]) != "" {
					<span class="gray">{ utils.ToString(m["Tipo"]) }</span>
				}
				if utils.ToString(m["Gran area 1"]) != "" {
					<span>{ utils.ToString(m["Gran area 1"]) }</span>
				}
				if utils.ToString(m["Gran area 2"]) != "" {
					<span>{ utils.ToString(m["Gran area 2"]) }</span>
				}
			</div>
			<p id="description">{ utils.ToString(m["Descripcion"]) }</p>
		</div>
	}
}

templ searchFilters(query string, documentTypes *list.List, documentAreas *list.List) {
	<div id="all-filters">
		<div class="dropdown">
			<button class="dropbtn" name="sortby" onclick="toggleDropdown(event)">
				SORT BY
			</button>
			<div id="sortby-menu" class="dropdown-content onlyone hidden">
				@sortingCheckboxes()
			</div>
		</div>
		<div class="dropdown">
			<button class="dropbtn" name="area" onclick="toggleDropdown(event)">
				AREA
			</button>
			<div id="document-area-menu" class="dropdown-content hidden">
				@valuesCheckboxes("area", false, documentAreas)
			</div>
		</div>
		<div class="dropdown">
			<button class="dropbtn" name="tipo" onclick="toggleDropdown(event)">
				TYPE
			</button>
			<div id="document-type-menu" class="dropdown-content onlyone hidden">
				@valuesCheckboxes("tipo", true, documentTypes)
			</div>
		</div>
		<input type="hidden" name="query" value={ query }/>
	</div>
	<script>

		document.addEventListener("click", () => { // Para cerrar el dropdown menu al cliquear afuera
			document.getElementById("document-type-menu").classList.add("hidden");
			document.getElementById("document-area-menu").classList.add("hidden");
			document.getElementById("sortby-menu").classList.add("hidden");
		});

		function toggleDropdown(e) {// Para abrir el dropdown menú que está oculto y ocultar otro si está abierto.
			e.stopPropagation();

			const typeMenu = document.getElementById("document-type-menu");
			const areaMenu = document.getElementById("document-area-menu");
			const sortbyMenu = document.getElementById("sortby-menu");

			let menu;

			if (e.currentTarget.name === "tipo") {
				menu = typeMenu;
				areaMenu.classList.add("hidden");
				sortbyMenu.classList.add("hidden");  
			} else if (e.currentTarget.name === "area") {
				menu = areaMenu;
				typeMenu.classList.add("hidden");
				sortbyMenu.classList.add("hidden");
			} else {
				menu = sortbyMenu;
				areaMenu.classList.add("hidden");
				typeMenu.classList.add("hidden");
			}

			menu.classList.toggle("hidden");
		}

		document.querySelectorAll(".dropdown-content").forEach(menu => { //Para evitar que se cierre luego de seleccionar una checkbox
			menu.addEventListener("click", (e) => {
				if (e.target.tagName === "INPUT") {
					e.stopPropagation();
				}
			});
		});

		document.querySelectorAll(".dropdown-content.onlyone").forEach(menu => { // Para permitir una sola box marcada.
			menu.addEventListener("change", (e) => {
				if (e.target.type !== "checkbox")
					return;
				
				const checkboxes = menu.querySelectorAll("input[type=checkbox]");
				checkboxes.forEach(cb => {
					if (cb !== e.target)
						cb.checked = false;
				});

				htmx.trigger(e.target, "mychange");
			});
		});

	</script>
}

templ valuesCheckboxes(name string, onlyone bool, values *list.List) {
	for e := values.Front(); e != nil; e = e.Next() {
		<label class="checkbox-item">
			<input
				type="checkbox"
				name={ name }
				value={ e.Value.(string) }
				hx-get="/search/update-filter"
				if onlyone {
					hx-trigger="mychange"
				}
				hx-target="#results"
				hx-swap="innerHTML"
				hx-include="#all-filters"
			/>
			{ e.Value.(string) }
		</label>
	}
}

templ sortingCheckboxes() {
	<label class="checkbox-item">
		<input
			type="checkbox"
			name="sortby"
			value="Nombre:asc"
			hx-get="/search/update-filter"
			hx-trigger="mychange"
			hx-target="#results"
			hx-swap="innerHTML"
			hx-include="#all-filters"
		/>
		Nombre ascendente
	</label>
	<label class="checkbox-item">
		<input
			type="checkbox"
			name="sortby"
			value="Nombre:desc"
			hx-get="/search/update-filter"
			hx-trigger="mychange"
			hx-target="#results"
			hx-swap="innerHTML"
			hx-include="#all-filters"
		/>
		Nombre descendente
	</label>
	<label class="checkbox-item">
		<input
			type="checkbox"
			name="sortby"
			value="Tipo:asc"
			hx-get="/search/update-filter"
			hx-trigger="mychange"
			hx-target="#results"
			hx-swap="innerHTML"
			hx-include="#all-filters"
		/>
		Tipo ascendente
	</label>
	<label class="checkbox-item">
		<input
			type="checkbox"
			name="sortby"
			value="Tipo:desc"
			hx-get="/search/update-filter"
			hx-trigger="mychange"
			hx-target="#results"
			hx-swap="innerHTML"
			hx-include="#all-filters"
		/>
		Tipo descendente
	</label>
}

// ------------------------------------------------------------------------------------------------
// Search Results Page
// ------------------------------------------------------------------------------------------------
templ SearchResultsPage(query string, hits []map[string]any, isUserAuthenticated bool, translator utils.Translator, documentTypes *list.List, documentAreas *list.List) {
	@Layout(query+" - SciFi Search", translator, func() templ.Component {
		return searchResultsContent(query, hits, isUserAuthenticated, translator, documentTypes, documentAreas)
	})
}

// ------------------------------------------------------------------------------------------------
