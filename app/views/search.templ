package views

import (
	"container/list"
	"scifi-search/app/utils"
)

// ------------------------------------------------------------------------------------------------
// Imports
// ------------------------------------------------------------------------------------------------

// ------------------------------------------------------------------------------------------------
// Search Results Content
// ------------------------------------------------------------------------------------------------
templ searchResultsContent(query string, hits []map[string]any, isUserAuthenticated bool, documentTypes *list.List) {
	@searchHeader(isUserAuthenticated)
	<main>
		<div class="search-container-grid">
			<div class="top"></div>
			<div class="left"></div>
			<div class="search-content">
				if len(hits) == 0 {
					<div class="message">
						<p>No results found for "{ query }".</p>
					</div>
				} else {
					<div class="message">
						<p>Search results for “{ query }”</p>
					</div>
					<div class="filters">
						@searchFilters(documentTypes)
					</div>
					<div class="results">
						@searchResults(hits)
					</div>
				}
			</div>
			<div class="right"></div>
		</div>
	</main>
}

templ searchHeader(isUserAuthenticated bool) {
	<header class="search-header">
		<div class="header-left">
			<a onclick="window.location.href='/'">
				<img src="static/img/logo_blanco.png" alt="icono" id="logo_scifi_header"/>
			</a>
			<input type="text" id="query" placeholder="Search for SCIENCE!!!"/>
		</div>
		<div class="header-right">
			<div class="header-buttons">
				if !isUserAuthenticated {
					<button class="header-button" onclick="window.location.href='/signup'">Sign-up</button>
					<button class="header-button" onclick="window.location.href='/login'">Log-in</button>
				} else {
					<button class="header-button" onclick="window.location.href='/profile'">Perfil</button>
				}
			</div>
		</div>
		<script>
			const input = document.getElementById("query");
			input.addEventListener("keypress", (e) => {
				if (e.key === "Enter") {
					const query = input.value.trim();
					if (!query) return;
					window.location.href = `/search?query=${encodeURIComponent(query)}`;
				}
			});
		</script>
	</header>
}

templ searchResults(hits []map[string]any) {
	for _, m := range hits {
		<div class="result">
			<a id="title" href={ utils.ToString(m["Link"]) }>{ utils.ToString(m["Nombre"]) }</a>
			<div class="extra-info">
				if utils.ToString(m["Tipo"]) != "" {
					<span class="gray">{ utils.ToString(m["Tipo"]) }</span>
				}
				if utils.ToString(m["Gran area 1"]) != "" {
					<span>{ utils.ToString(m["Gran area 1"]) }</span>
				}
				if utils.ToString(m["Gran area 2"]) != "" {
					<span>{ utils.ToString(m["Gran area 2"]) }</span>
				}
			</div>
			<p id="description">{ utils.ToString(m["Descripcion"]) }</p>
			<p>{ len(hits) } </p>
		</div>
	}
}

templ searchFilters(documentTypes *list.List) {
	<button class="dropbtn">SORT BY</button>
	<button class="dropbtn">AREA</button>
	<div class="dropdown">
		<button class="dropbtn" onclick="toggleDropdown(event)">TYPE</button>
		<div class="dropdown-content" id="typeDropdown">
			@documentTypeCheckboxes(documentTypes)
		</div>
	</div>
	<script>
		function toggleDropdown(e) {
			e.stopPropagation();
			document.getElementById("typeDropdown").classList.toggle("show");
		}

		document.addEventListener("click", () => {
			document.getElementById("typeDropdown").classList.remove("show");
		});
	</script>
}

templ documentTypeCheckboxes(documentTypes *list.List) {
	for e := documentTypes.Front(); e != nil; e = e.Next() {
		<label class="checkbox-item">
			<input
				type="checkbox"
				name="doctype"
				value={ e.Value.(string) }
			/>
			{ e.Value.(string) }
		</label>
	}
}

// ------------------------------------------------------------------------------------------------
// Search Results Page
// ------------------------------------------------------------------------------------------------
templ SearchResultsPage(query string, hits []map[string]any, isUserAuthenticated bool, translator utils.Translator, documentTypes *list.List) {
	@Layout(query+" - SciFi Search", translator, func() templ.Component {
		return searchResultsContent(query, hits, isUserAuthenticated, documentTypes)
	})
}

// ------------------------------------------------------------------------------------------------
