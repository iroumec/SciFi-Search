package views

import "scifi-search/app/utils"

// ------------------------------------------------------------------------------------------------
// Imports
// ------------------------------------------------------------------------------------------------

// ------------------------------------------------------------------------------------------------
// Search Results Content
// ------------------------------------------------------------------------------------------------
templ searchResultsContent(query string, hits []map[string]any, isUserAuthenticated bool) {
    @searchHeader(isUserAuthenticated)
    <main>
        <div class="search-container-grid">
            <div class="filter-section">
                @Filters()
            </div>
            <div class="results-section">
                <div class="results">
                    if len(hits) == 0 {
                        <p>No se encontraron resultados.</p>
                    } else {
                        <h1>Resultados de búsqueda para “{ query }”</h1>

                        for _, m := range hits {
							<div class="result">
								<a id="title" href={ utils.ToString(m["Link"]) }>{ utils.ToString(m["Nombre"]) }</a>

								<div class="extra-info">
									if utils.ToString(m["Tipo"]) != "" {
										<span>{ utils.ToString(m["Tipo"]) }</span>
									}
									if utils.ToString(m["Gran area 1"]) != "" {
										<span>{ utils.ToString(m["Gran area 1"]) }</span>
									}
									if utils.ToString(m["Gran area 2"]) != "" {
										<span>{ utils.ToString(m["Gran area 2"]) }</span>
									}
								</div>

								<p id="description">{ utils.ToString(m["Descripcion"]) }</p>
							</div>
						}

                    }
                </div>
            </div>
        </div>
    </main>
}


templ searchHeader(isUserAuthenticated bool){
	<header class="search-header">
		<div class="header-left">
			<a onclick="window.location.href='/'">
				<img src="static/img/logo_blanco.png" alt="icono" id="logo_scifi_header"/>
			</a>
			<input type="text" id="query" placeholder="Search for SCIENCE!!!"/>
		</div>
		<div class="header-right">
			<div class="header-buttons">
			if !isUserAuthenticated {
				<button class="header-button" onclick="window.location.href='/signup'">Sign-up</button>
				<button class="header-button" onclick="window.location.href='/login'">Log-in</button>
			} else {
				<button class="header-button" onclick="window.location.href='/profile'">Perfil</button>
			}
			</div>
		</div>
		<script>
			const input = document.getElementById("query");
			input.addEventListener("keypress", (e) => {
				if (e.key === "Enter") {
					const query = input.value.trim();
					if (!query) return;
					window.location.href = `/search?query=${encodeURIComponent(query)}`;
				}
			});
		</script>
	</header>
}

// ------------------------------------------------------------------------------------------------
// Search Results Page
// ------------------------------------------------------------------------------------------------
templ SearchResultsPage(query string, hits []map[string]any, isUserAuthenticated bool) {
	@Layout(query+" - SciFi Search", func() templ.Component {
		return searchResultsContent(query, hits, isUserAuthenticated)
	})
}

// ------------------------------------------------------------------------------------------------
