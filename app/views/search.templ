package views

import (
	"container/list"
	"scifi-search/app/utils"
)

// ------------------------------------------------------------------------------------------------
// Imports
// ------------------------------------------------------------------------------------------------

// ------------------------------------------------------------------------------------------------
// Search Results Content
// ------------------------------------------------------------------------------------------------
templ searchResultsContent(query string, hits []map[string]any, isUserAuthenticated bool, documentTypes *list.List, documentAreas *list.List) {
	@searchHeader(isUserAuthenticated)
	<main>
		<div class="search-container-grid">
			<div class="top"></div>
			<div class="left"></div>
			<div class="search-content">
				if len(hits) == 0 {
					<div class="message">
						<p>No results found for "{ query }".</p>
					</div>
				} else {
					<div class="message">
						<p>Search results for “{ query }”</p>
					</div>
					<div class="filters">
						@searchFilters(query, documentTypes, documentAreas)
					</div>
					<div id="results">
						@SearchResults(hits)
					</div>
				}
			</div>
			<div class="right"></div>
		</div>
	</main>
}

templ searchHeader(isUserAuthenticated bool) {
	<header class="search-header">
		<div class="header-left">
			<a onclick="window.location.href='/'">
				<img src="static/img/logo_blanco.png" alt="icono" id="logo_scifi_header"/>
			</a>
			<input type="text" id="query" placeholder="Search for SCIENCE!!!"/>
		</div>
		<div class="header-right">
			<div class="header-buttons">
				if !isUserAuthenticated {
					<button class="header-button" onclick="window.location.href='/signup'">Sign-up</button>
					<button class="header-button" onclick="window.location.href='/login'">Log-in</button>
				} else {
					<button class="header-button" onclick="window.location.href='/profile'">Perfil</button>
				}
			</div>
		</div>
		<script>
			const input = document.getElementById("query");
			input.addEventListener("keypress", (e) => {
				if (e.key === "Enter") {
					const query = input.value.trim();
					if (!query) return;
					window.location.href = `/search?query=${encodeURIComponent(query)}`;
				}
			});
		</script>
	</header>
}

templ SearchResults(hits []map[string]any) {
	for _, m := range hits {
		<div class="result">
			<a id="title" href={ utils.ToString(m["Link"]) }>{ utils.ToString(m["Nombre"]) }</a>
			<div class="extra-info">
				if utils.ToString(m["Tipo"]) != "" {
					<span class="gray">{ utils.ToString(m["Tipo"]) }</span>
				}
				if utils.ToString(m["Gran area 1"]) != "" {
					<span>{ utils.ToString(m["Gran area 1"]) }</span>
				}
				if utils.ToString(m["Gran area 2"]) != "" {
					<span>{ utils.ToString(m["Gran area 2"]) }</span>
				}
			</div>
			<p id="description">{ utils.ToString(m["Descripcion"]) }</p>
		</div>
	}
}

templ searchFilters(query string, documentTypes *list.List, documentAreas *list.List) {
	<button class="dropbtn">SORT BY</button>
	<div id="all-filters">
		<div class="dropdown">

			<button class="dropbtn" name="area" onclick="toggleDropdown(event)">
				AREA
			</button>
			<div id="document-area-menu" class="dropdown-content hidden">
				@valuesCheckboxes("area", documentAreas)
			</div>

		</div>
		<div class="dropdown">

			<button class="dropbtn" name="tipo" onclick="toggleDropdown(event)">
				TYPE
			</button>
			<div id="document-type-menu" class="dropdown-content hidden">
				@valuesCheckboxes("tipo", documentTypes)
			</div>

		</div>
		<input type="hidden" name="query" value={ query }>
	</div>
	<script>

		document.addEventListener("click", () => { // Para cerrar el dropdown menu al cliquear afuera
			document.getElementById("document-type-menu").classList.add("hidden");
			document.getElementById("document-area-menu").classList.add("hidden");
		});

		function toggleDropdown(e) {// Para abrir el dropdown menú que está oculto y ocultar el otro si estaba abierto.
			e.stopPropagation();

			const typeMenu = document.getElementById("document-type-menu");
			const areaMenu = document.getElementById("document-area-menu");

			let menu;

			if (e.currentTarget.name === "tipo") {
				menu = typeMenu;
				areaMenu.classList.add("hidden");  
			} else {
				menu = areaMenu;
				typeMenu.classList.add("hidden");  
			}

			menu.classList.toggle("hidden");
		}

		document.querySelectorAll(".dropdown-content").forEach(menu => {
			menu.addEventListener("click", (e) => {
				if (e.target.tagName === "INPUT") {
					e.stopPropagation();
				}
			});
		});

		document.getElementById("document-type-menu").addEventListener("change", (e) => { // Para permitir una sola box marcada.
			if (e.target.type !== "checkbox") 
				return;

			const checkboxes = document.querySelectorAll("#document-type-menu input[type=checkbox]");
			checkboxes.forEach(cb => {
				if (cb !== e.target)
					cb.checked = false; 
			});
			
			htmx.trigger(e.target, "change");
		});
	</script>
}

templ valuesCheckboxes(name string, values *list.List) {
	for e := values.Front(); e != nil; e = e.Next() {
		<label class="checkbox-item">
			<input
				type="checkbox"
				name={ name }
				value={ e.Value.(string) }
				hx-get="/search/update-filter"
				hx-target="#results"
				hx-swap="innerHTML"
				hx-include="#all-filters"
			/>
			{ e.Value.(string) }
		</label>
	}
}

// ------------------------------------------------------------------------------------------------
// Search Results Page
// ------------------------------------------------------------------------------------------------
templ SearchResultsPage(query string, hits []map[string]any, isUserAuthenticated bool, translator utils.Translator, documentTypes *list.List, documentAreas *list.List) {
	@Layout(query+" - SciFi Search", translator, func() templ.Component {
		return searchResultsContent(query, hits, isUserAuthenticated, documentTypes, documentAreas)
	})
}

// ------------------------------------------------------------------------------------------------
