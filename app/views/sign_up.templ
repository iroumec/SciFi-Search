package views

import "scifi-search/app/languages"

// ------------------------------------------------------------------------------------------------
// Services
// ------------------------------------------------------------------------------------------------
templ SignUpPage(errorMessage string, authorizationLevel int, translator languages.Translator) {
	@Layout(translator("core.sign-up"), translator,
		func() templ.Component { return AuthHeader(authorizationLevel, translator) },
		func() templ.Component { return signUpContent(errorMessage, translator) },
	)
}

// ------------------------------------------------------------------------------------------------
// Functions
// ------------------------------------------------------------------------------------------------
templ signUpFields(translator languages.Translator) {
	<div id="form-inputs">
		<input
			id="name"
			type="text"
			name="name"
			placeholder={ translator("core.name") }
			required
		/>
		<input
			id="surname"
			type="text"
			name="surname"
			placeholder={ translator("core.surname") }
			required
		/>
		<input
			id="email"
			type="email"
			name="email"
			placeholder={ translator("core.email") }
			required
		/>
		<input
			id="password"
			type="password"
			name="password"
			placeholder={ translator("core.password") }
			required
		/>
	</div>
}

// ------------------------------------------------------------------------------------------------
templ signUpContent(errorMessage string, translator languages.Translator) {
	<div class="only-form-content">
		<div class="centered-container">
			<form
				id="signup-form"
				hx-post="/signup"
				hx-target="body"
				hx-push-url="true"
			>
				@signUpFields(translator)
				<button class="scifi-button" type="submit">
					{ translator("core.sign-up") }
				</button>
			</form>
		</div>
	</div>
}

// ------------------------------------------------------------------------------------------------
