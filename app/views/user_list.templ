package views 

import (
    sqlc "tpe/web/app/database"
)

templ userList(list []sqlc.User) {
    <div class="user-list">
        <div class="centered-container">
            <ul id="user-list">
                for _, user := range list {
                    <li> 
                        { user.Name } 
                        { user.Surname }
                    </li>
                } 
            </ul>
        </div>
    </div>
}