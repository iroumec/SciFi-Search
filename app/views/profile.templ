package views

import sqlc "scifi-search/app/database"

// ------------------------------------------------------------------------------------------------
// Imports
// ------------------------------------------------------------------------------------------------
templ loggedProfileContent(user sqlc.User) {
	<div class="profile-container">
		<h1>Bienvenido, { user.Name } { user.Surname }!</h1>
		<a href="/signout" id="signout">Cerrar sesión</a>
	</div>
}

// ------------------------------------------------------------------------------------------------
// Profile Page
// ------------------------------------------------------------------------------------------------
templ LoggedProfilePage(user sqlc.User) {
	@Layout(user.Name, true, func() templ.Component {
		return loggedProfileContent(user)
	})
}

// ------------------------------------------------------------------------------------------------
templ UnloggedProfilePage() {
	<h1>INICIE SESIÓN. NO HAY SESIÓN</h1>
}
