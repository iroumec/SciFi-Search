package views

import "scifi-search/app/utils"

import sqlc "scifi-search/app/database"

// ------------------------------------------------------------------------------------------------
// Imports
// ------------------------------------------------------------------------------------------------
templ loggedProfileContent(user sqlc.User, searches []string, translator utils.Translator) {
	<div class="profile-container">
		<h1>Bienvenido, { user.Name } { user.Surname }!</h1>
		if user.AvatarUrl.Valid {
			<img
				src={ user.AvatarUrl.String }
				alt="Avatar del usuario"
				class="avatar-img"
			/>
		} else {
			<p>No tiene avatar cargado.</p>
		}
		<form action="/avatar" method="POST" enctype="multipart/form-data" class="avatar-upload-form">
			<label for="avatar">{ translator("profile.upload_new_avatar") } </label>
			<input type="file" id="avatar" name="avatar" accept="image/*" required/>
			<button type="submit">Actualizar avatar</button>
		</form>
		<p></p>
		<a href="/signout" id="signout">Cerrar sesión</a>
		<h2>Búsquedas antiguas</h2>
		<ul id="the-user-list">
			for _, search := range searches {
				<li>{ search }</li>
			}
		</ul>
	</div>
}

// ------------------------------------------------------------------------------------------------
// Profile Page
// ------------------------------------------------------------------------------------------------
templ LoggedProfilePage(user sqlc.User, searches []string, translator utils.Translator) {
	@Layout(user.Name, func() templ.Component {
		return loggedProfileContent(user, searches, translator)
	})
}

// ------------------------------------------------------------------------------------------------
templ UnloggedProfilePage() {
	<h1>INICIE SESIÓN. NO HAY SESIÓN</h1>
}
