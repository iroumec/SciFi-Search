package views

// ------------------------------------------------------------------------------------------------
// Imports
// ------------------------------------------------------------------------------------------------

import (
	"html/template"
	"scifi-search/app/languages"
)

// ------------------------------------------------------------------------------------------------
// Services
// ------------------------------------------------------------------------------------------------
templ TrendsPage(htmlChart template.HTML, authorizationLevel int, translator languages.Translator) {
	@Layout(translator("trends"), translator,
		func() templ.Component { return Header(true, authorizationLevel, translator) },
		func() templ.Component { return trendsContent(htmlChart, translator) },
	)
}

// ------------------------------------------------------------------------------------------------
// Functions
// ------------------------------------------------------------------------------------------------
templ trendsContent(htmlChart template.HTML, translator languages.Translator) {
	<div class="centered-box-content trends">
		<div id="left"></div>
		<div id="trends-content">
			<div id="trends-container">
				<div id="trends-header">
					<p>{ translator("search-trends") }</p>
				</div>
				<div class="chart-wrapper">
					<div class="chart">
						@templ.Raw(string(htmlChart))
					</div> // TODO: ver la traduccion de htmlChart
				</div>
			</div>
		</div>
		<div id="right"></div>
	</div>
}

// ------------------------------------------------------------------------------------------------
