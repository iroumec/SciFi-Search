package views

import "scifi-search/app/languages"

// ------------------------------------------------------------------------------------------------
// Constants
// ------------------------------------------------------------------------------------------------

// Scripts
const (
	htmxScript    = "https://unpkg.com/htmx.org@1.9.12"
	echartsScript = "https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"
	alpineScript  = "https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
)

// Repositories
const (
	sciFiSearchRepository = "https://github.com/iroumec/SciFi-Search"
)

// ------------------------------------------------------------------------------------------------
// Services
// ------------------------------------------------------------------------------------------------
templ Layout(
	title string,
	translator languages.Translator,
	header func() templ.Component,
	content func() templ.Component,
) {
	<!DOCTYPE html>
	<html lang="es">
		<!-- HTMX Script -->
		<script src={ htmxScript }></script>
		<!-- ECharts Script -->
		<script src={ echartsScript }></script>
		<!-- Alpine.js -->
		<script defer src={ alpineScript }></script>
		<head>
			<meta charset="UTF-8"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@100;400;700&display=swap"/>
			<link rel="icon" type="image/png" href="/static/img/logos/scifi-blue.png"/>
		</head>
		<body>
			@showPopUp()
			<div class="container-grid">
				@header()
				@content()
				@Footer(translator)
			</div>
		</body>
	</html>
}

// ------------------------------------------------------------------------------------------------
