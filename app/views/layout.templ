package views

// ------------------------------------------------------------------------------------------------
// Header
// ------------------------------------------------------------------------------------------------
templ Header() {
	<header class="header">
		<div class="header-buttons">
			<button class="header-button" onclick="window.location.href='/signup'">Sign-up</button>
			<button class="header-button" onclick="window.location.href='/signin'">Log-in</button>
			<!--Boton de Desplegar menu, solo cuando ya está iniciado sesion-->
		</div>
	</header>
}

// ------------------------------------------------------------------------------------------------
// Layout
// ------------------------------------------------------------------------------------------------
templ Layout(title string, content func() templ.Component) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<link rel="icon" type="image/png" href="/static/img/icono.png"/>
		</head>
		<body>
			<div class="contenedor-grid">
				@Header()
				@content()
				@Footer()
			</div>
		</body>
	</html>
}

// ------------------------------------------------------------------------------------------------
// Footer
// ------------------------------------------------------------------------------------------------
templ Footer() {
	<footer class="footer">
		<p class="footer-text">
			powered by
			<a href="https://www.meilisearch.com/" target="_blank">
				<img src="static/img/logo_meilisearch_negro.png" alt="Logo Meilisearch" id="logo-meilisearch"/>
			</a>
			<a href="https://supertokens.com/" target="_blank">
				<img src="static/img/logo_supertokens.png" alt="Logo Meilisearch" id="logo-meilisearch"/>
			</a>
		</p>
	</footer>
}
