package views

import "scifi-search/app/languages"

// ------------------------------------------------------------------------------------------------
// Constants
// ------------------------------------------------------------------------------------------------

// Scripts
const (
	htmxScript    = "https://unpkg.com/htmx.org@1.9.12"
	echartsScript = "https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"
	alpineScript  = "https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
)

// Repositories
const (
	sciFiSearchRepository = "https://github.com/iroumec/SciFi-Search"
)

// ------------------------------------------------------------------------------------------------
// Services
// ------------------------------------------------------------------------------------------------
templ Layout(
	title string,
	translator languages.Translator,
	header func() templ.Component,
	content func() templ.Component,
) {
	<!DOCTYPE html>
	<html lang="es">
		<!-- HTMX Script -->
		<script src={ htmxScript }></script>
		<!-- ECharts Script -->
		<script src={ echartsScript }></script>
		<!-- Alpine.js -->
		<script defer src={ alpineScript }></script>
		<head>
			<meta charset="UTF-8"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/styles.css"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@100;400;700&display=swap"/>
			<link rel="icon" type="image/png" href="/static/img/icono.png"/>
		</head>
		<body>
			@showPopUp()
			<div class="contenedor-grid">
				@header()
				@content()
				@Footer(translator)
			</div>
		</body>
	</html>
}

// ------------------------------------------------------------------------------------------------
templ Footer(translator languages.Translator) {
	<footer class="footer">
		<div class="clear-top"></div>
		<div class="clear-left"></div>
		<div id="powered-section">
			<p>{ translator("powered-by") } </p>
			<div id="images">
				<a href="https://www.meilisearch.com/" target="_blank">
					<img
						src="static/img/logo-meilisearch.png"
						alt="Logo Meilisearch"
						id="logo-meilisearch"
						class="logo"
					/>
				</a>
				<a href="https://supertokens.com/" target="_blank">
					<img
						src="static/img/logo-supertokens.png"
						alt="Logo Supertokens"
						id="logo-supertokens"
						class="logo"
					/>
				</a>
				<a href="https://github.com/minio/minio" target="_blank">
					<img
						src="static/img/logo-minio.svg"
						alt="Logo MinIO"
						id="logo-minio"
						class="logo"
					/>
				</a>
			</div>
		</div>
		<div id="unicen-logo">
			<a href="https://www.unicen.edu.ar/" target="_blank">
				<img src="static/img/logo-unicen.png" alt="Logo Supertokens" id="logo-unicen"/>
			</a>
		</div>
		<div id="options-section">
			<button
				class="footer-button"
				onclick="window.location.href='/trends'"
			>
				{ translator("trends") }
			</button>
			<button
				class="footer-button"
				hx-get="/language"
				hx-swap="none"
				if translator("current-lang") == "ES" {
					hx-vals='{"language":"en"}'
				} else {
					hx-vals='{"language":"es"}'
				}
			>
				{ translator("language") + ": " + translator("current-lang") }
			</button>
			<a
				id="github-btn"
				class="footer-button"
				href={ sciFiSearchRepository }
				target="_blank"
			>
				{ translator("footer.github") }
			</a>
		</div>
		<div class="clear-right"></div>
	</footer>
}

// ------------------------------------------------------------------------------------------------
