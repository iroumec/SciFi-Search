package views 

import "scifi-search/app/languages"

templ Header(showOptions bool, authorizationLevel int, translator languages.Translator) {
	@headerBuilder("transparent", "logo.png", false, true, authorizationLevel, translator)
}

// ------------------------------------------------------------------------------------------------
templ AuthHeader(authorizationLevel int, translator languages.Translator) {
	@headerBuilder("transparent", "logo.png", false, false, authorizationLevel, translator)
}

// ------------------------------------------------------------------------------------------------
templ IndexHeader(authorizationLevel int, translator languages.Translator) {
	@headerBuilder("transparent", "", false, true, authorizationLevel, translator)
}

// ------------------------------------------------------------------------------------------------
templ SearchHeader(authorizationLevel int, translator languages.Translator) {
	@headerBuilder("var(--scifi30)", "white-logo.png", true, true, authorizationLevel, translator)
}

// ------------------------------------------------------------------------------------------------
templ headerBuilder(backgroundColor string, logo string, query bool, showOptions bool, authorizationLevel int, translator languages.Translator) {
	<header style={ "background-color: " + backgroundColor + ";" }>
		<div class="header-left">
			if logo != "" {
				<img
					src={ "static/img/" + logo }
					alt="Scifi Search Logo"
					id="header-logo"
					hx-get="/"
					hx-target="body"
					hx-push-url="true"
					style="cursor: pointer;"
				/>
			}
			if query {
				<form hx-get="/search" hx-target="body" hx-push-url="true">
					<input
						type="text"
						name="query"
						id="query"
						placeholder={ translator("search_for_science") }
						hx-trigger="keyup[key=='Enter']"
						hx-get="/search"
						hx-target="body"
						hx-push-url="true"
						hx-include="this"
					/>
				</form>
			}
		</div>
		<div class="header-right">
			if showOptions {
				@userOptions(authorizationLevel, translator)
			}
		</div>
	</header>
}
