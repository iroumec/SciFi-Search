package views 

import "scifi-search/app/utils"

// ------------------------------------------------------------------------------------------------

// ------------------------------------------------------------------------------------------------
templ Header() {
	<header class="header">
		<a onclick="window.location.href='/'">
			<img src="static/img/logo.png" alt="icono" style="width:240px; height:70px;" id="header-logo"/>
		</a>
	</header>
}

// ------------------------------------------------------------------------------------------------
templ IndexHeader(isUserAuthenticated bool, translator utils.Translator) {
	<header class="index-header">
		@userOptions(isUserAuthenticated, translator)
		<!--button class="header-button" onclick="window.location.href='/trends'">Trends</button-->
	</header>
}

// ------------------------------------------------------------------------------------------------
templ SearchHeader(isUserAuthenticated bool, translator utils.Translator) {
	<header class="search-header">
		<div class="header-left">
			<a onclick="window.location.href='/'">
				<img src="static/img/logo_blanco.png" alt="icono" id="logo_scifi_header"/>
			</a>
			<input type="text" id="query" placeholder="Search for SCIENCE!!!"/>
		</div>
		<div class="header-right">
			@userOptions(isUserAuthenticated, translator)
		</div>
		<script>
			const input = document.getElementById("query");
			input.addEventListener("keypress", (e) => {
				if (e.key === "Enter") {
					const query = input.value.trim();
					if (!query) return;
					window.location.href = `/search?query=${encodeURIComponent(query)}`;
				}
			});
		</script>
	</header>
}

// ------------------------------------------------------------------------------------------------
templ userOptions(isUserAuthenticated bool, translator utils.Translator) {
	if !isUserAuthenticated {
		<button class="scifi-button" onclick="window.location.href='/signup'">{ translator("sign-up.tag") }</button>
		<button class="scifi-button" onclick="window.location.href='/login'">{ translator("log-in.tag") }</button>
	} else {
		<div class="index-menu">
			<button id="header-menu" onclick="toggleSlidemenu(event)">
				<img src="static/img/menu.svg" alt="header-menu-img" id="header-menu-img"/>
			</button>
			<div id="menu" class="menu-content hidden">
				<div id="close-menu">MENU</div>
				<button class="menu-button" onclick="window.location.href='/settings'">Configuración</button>
				<button class="menu-button" onclick="window.location.href='/history'">Historial</button>
				<button class="menu-button" onclick="window.location.href='/funding'">Subir un proyecto</button>
				<button class="menu-button" onclick="window.location.href='/trends'">Tendencias</button>
				<button class="menu-button" onclick="window.location.href='/signout'">Cerrar sesión</button>
			</div>
		</div>
	}
	<script>
        (function() {
            function toggleSlidemenu(e) {
                e.stopPropagation();
                const menu = document.getElementById("menu");
                const menuImg = document.getElementById("header-menu-img");
                if (menu) menu.classList.toggle("hidden");
                if (menuImg) menuImg.classList.toggle("hidden");
            }
            
            // Se hace la función global para que onclick pueda accederla.
            window.toggleSlidemenu = toggleSlidemenu;
            
            // Se cierra el menú si se hace click fuera del menú.
            document.addEventListener("click", function(e) {
                const menu = document.getElementById("menu");
                const menuButton = document.getElementById("header-menu");
                const flashPopup = document.getElementById("flash-popup");
                
                // No cerrar si se clickea el menú mismo, el botón del menú, o el popup.
                if (menu && menuButton && 
                    !menu.contains(e.target) && 
                    !menuButton.contains(e.target) &&
                    (!flashPopup || !flashPopup.contains(e.target))) {
                    menu.classList.add("hidden");
                    const menuImg = document.getElementById("header-menu-img");
                    if (menuImg && menuImg.classList.contains("hidden")) {
                        menuImg.classList.remove("hidden");
                    }
                }
            });
        })();
    </script>
}

// ------------------------------------------------------------------------------------------------
