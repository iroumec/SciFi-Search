package views 

import "scifi-search/app/languages"

templ Header(showOptions bool, isUserAuthenticated bool, translator languages.Translator) {
	@headerBuilder("transparent", "logo.png", false, true, isUserAuthenticated, translator)
}

// ------------------------------------------------------------------------------------------------
templ AuthHeader(translator languages.Translator) {
	@headerBuilder("transparent", "logo.png", false, false, false, translator)
}

// ------------------------------------------------------------------------------------------------
templ IndexHeader(isUserAuthenticated bool, translator languages.Translator) {
	@headerBuilder("transparent", "", false, true, isUserAuthenticated, translator)
}

// ------------------------------------------------------------------------------------------------
templ SearchHeader(isUserAuthenticated bool, translator languages.Translator) {
	@headerBuilder("var(--scifi30)", "white-logo.png", true, true, isUserAuthenticated, translator)
}

// ------------------------------------------------------------------------------------------------
templ headerBuilder(backgroundColor string, logo string, query bool, showOptions bool, isUserAuthenticated bool, translator languages.Translator) {
	<header style={ "background-color: " + backgroundColor + ";" }>
		<div class="header-left">
			if logo != "" {
				<a href="/">
					<img src={ "static/img/" + logo  } alt="Scifi Search Logo" id="header-logo"/>
				</a>
			}
			if query {
				<form hx-get="/search" hx-target="body" hx-push-url="true">
					<input
						type="text"
						name="query"
						id="query"
						placeholder="Search for SCIENCE!!!"
						hx-trigger="keyup[key=='Enter']"
						hx-get="/search"
						hx-target="body"
						hx-push-url="true"
						hx-include="this"
					/>
				</form>
			}
		</div>
		<div class="header-right">
			if showOptions {
				@userOptions(isUserAuthenticated, translator)
			}
		</div>
	</header>
}

// ------------------------------------------------------------------------------------------------
templ userOptions(isUserAuthenticated bool, translator languages.Translator) {
	if !isUserAuthenticated {
		<button
			class="scifi-button"
			hx-get="/signup"
			hx-target="body"
			hx-push-url="true"
		>
			{ translator("sign-up.tag") }
		</button>
		<button
			class="scifi-button"
			hx-get="/login"
			hx-target="body"
			hx-push-url="true"
		>
			{ translator("log-in.tag") }
		</button>
	} else {
		<div
			class="index-menu"
			x-data="{ open: false }"
			@click.outside="open = false"
		>
			<button id="header-menu" @click.stop="open = !open">
				<img
					src="static/img/menu.svg"
					alt="header-menu-img"
					id="header-menu-img"
					x-show="!open"
				/>
			</button>
			<div id="menu" class="menu-content" x-show="open" style="display: none;">
				<div id="close-menu">MENU</div>
				<button class="menu-button" hx-get="/settings" hx-target="body" hx-push-url="true">Configuración</button>
				<button class="menu-button" hx-get="/history" hx-target="body" hx-push-url="true">Historial</button>
				<button class="menu-button" hx-get="/funding" hx-target="body" hx-push-url="true">Administrar proyectos</button>
				<button class="menu-button" hx-get="/trends" hx-target="body" hx-push-url="true">Tendencias</button>
				<button class="menu-button" hx-get="/signout" hx-target="body" hx-push-url="true">Cerrar sesión</button>
			</div>
		</div>
	}
}

// ------------------------------------------------------------------------------------------------
