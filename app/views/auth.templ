package views 

import "scifi-search/app/languages"

// ------------------------------------------------------------------------------------------------
// ----------------------------------------- Sign Up ----------------------------------------------
// ------------------------------------------------------------------------------------------------
templ signUpContent(errorMessage string, translator languages.Translator) {
	@showPopUp()
	<div class="only-form-content">
		<div class="centered-container">
			<form
				id="signup-form"
				hx-post="/signup"
				hx-target="body"
				hx-push-url="true"
			>
				<div id="form-inputs">
					<input
						id="name"
						type="text"
						name="name"
						placeholder={ translator("name") }
						required
					/>
					<input
						id="surname"
						type="text"
						name="surname"
						placeholder={ translator("surname") }
						required
					/>
					<input
						id="email"
						type="email"
						name="email"
						placeholder={ translator("email") }
						required
					/>
					<input
						id="password"
						type="password"
						name="password"
						placeholder={ translator("password") }
						required
					/>
				</div>
				<button class="scifi-button" type="submit">
					{ translator("sign-up") }
				</button>
			</form>
		</div>
	</div>
}

// ------------------------------------------------------------------------------------------------
templ SignUpPage(errorMessage string, translator languages.Translator) {
	@Layout(translator("sign-up"), translator,
		func() templ.Component { return AuthHeader(translator) },
		func() templ.Component { return signUpContent(errorMessage, translator) },
	)
}

// ------------------------------------------------------------------------------------------------
// ----------------------------------------- Log In -----------------------------------------------
// ------------------------------------------------------------------------------------------------
templ loginContent(translator languages.Translator) {
	@showPopUp()
	<div class="only-form-content">
		<div class="centered-container">
			<form
				id="login-form"
				hx-post="/login"
				hx-target="body"
				hx-push-url="true"
			>
				<div id="form-inputs">
					<input
						id="email"
						type="email"
						name="email"
						placeholder={ translator("email") }
						required
					/>
					<input
						id="password"
						type="password"
						name="password"
						placeholder={ translator("password") }
						required
					/>
				</div>
				<button class="scifi-button" type="submit">
					{ translator("log-in") }
				</button>
			</form>
		</div>
	</div>
}

// ------------------------------------------------------------------------------------------------
templ LoginPage(translator languages.Translator) {
	@Layout(translator("log-in"), translator,
		func() templ.Component { return AuthHeader(translator) },
		func() templ.Component { return loginContent(translator) },
	)
}

// ------------------------------------------------------------------------------------------------
// --------------------------------------- No session ---------------------------------------------
// ------------------------------------------------------------------------------------------------
templ UnloggedContent(translator languages.Translator) {
	<div id="no-session">
		<p>{ translator("no-session") }</p>
		<div id="buttons">
			<button
				class="scifi-button"
				hx-get="/signup"
				hx-target="body"
				hx-push-url="true"
			>
				{ translator("sign-up.tag") }
			</button>
			<button
				class="scifi-button"
				hx-get="/login"
				hx-target="body"
				hx-push-url="true"
			>
				{ translator("log-in.tag") }
			</button>
		</div>
	</div>
}

templ UnloggedPage(translator languages.Translator) {
	@Layout("No session", translator,
		func() templ.Component { return AuthHeader(translator) },
		func() templ.Component { return UnloggedContent(translator) },
	)
}

// ------------------------------------------------------------------------------------------------
// -------------------------------------- Session info --------------------------------------------
// ------------------------------------------------------------------------------------------------
templ SessionInfo(userID string, payload map[string]string) {
	<html>
		<head>
			<title>Session Info</title>
		</head>
		<body>
			<h1>Session activa</h1>
			<p><strong>User ID:</strong> { userID }</p>
			<h2>Datos de sesión</h2>
			<ul>
				for key, value := range payload {
					<li>
						<strong>{ key }:</strong> { value }
					</li>
				}
			</ul>
		</body>
	</html>
}

// ------------------------------------------------------------------------------------------------
