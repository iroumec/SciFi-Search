package views 

import (
	"scifi-search/app/utils"
	"fmt"
	"time"
)

templ settingsContent(user utils.User, preferences []string) {
	@Header()
	<div class="centered-box-content">
		<div id="left"></div>
		@SettingsForm(user, preferences)
		<div id="right"></div>
	</div>
}

templ SettingsForm(user utils.User, preferences []string) {
	<form
		id="settings-section"
		enctype="multipart/form-data"
	>
		<div class="profile-settings">
			<p class="subtitle" id="profile">Profile</p>
			<p id="fullname">{ user.Name } { user.Surname } </p>
			<div class="info-section">
				<div class="centered-container">
					@InfoField("name", "text", user.Name)
					@InfoField("surname", "text", user.Surname)
					@InfoField("email", "email", user.Email)
					@InfoField("password", "password", "********")
				</div>
			</div>
		</div>
		<div id="avatar-settings">
			@AvatarSettings(user)
		</div>
		<div class="preferences-settings">
			<p class="subtitle" id="preference">Preferences</p>
			<div id="preferences-list">
				for _, p := range preferences {
					@PreferenceItem(p)
				}
			</div>
			<div id="add-preference">
				<input id="preference-field" type="text" name="preferences[]"/>
				<button
					type="button"
					class="scifi-button"
					hx-get="/settings/add-preference"
					hx-include="#preference-field"
					hx-target="#preferences-list"
					hx-swap="beforeend"
					hx-on="htmx:afterRequest: document.getElementById('preference-field').value=''"
				>
					Submit
				</button>
			</div>
		</div>
		<div class="nav-section">
			<div id="set-left">
				<button
					type="button"
					class="scifi-button"
					id="delete-account-btn"
					hx-delete="/delete-account"
					hx-confirm="¿Estás seguro de que deseas eliminar tu cuenta? Esta acción es irreversible."
					hx-target="body"
				>
					Delete account
				</button>
			</div>
			<div id="set-right">
				<button 
					type="button"
					class="scifi-button"
					hx-get="/settings/cancel"
					hx-confirm="Are you sure you want to cancel the changes? This action is irreversible."
					hx-target="#settings-section"
					hx-swap="outerHTML"
				> Cancel 
				</button>

				<button 
					type="button"
					class="scifi-button"
					hx-post="/settings/save"
					hx-encoding="multipart/form-data"
					hx-target="#settings-section"
					hx-swap="outerHTML"
				>
					Save changes 
				</button>
			</div>
		</div>
	</form>
}

templ InfoField(name string, typeStr string, value string) {
	<div id={ "field-" + name }>
		<input
			type={ typeStr }
			name={ name }
			value={ value }
			disabled="true"
		/>
		<button
			type="button"
			class="scifi-button"
			hx-get={ "/settings/edit/" + name }
			hx-target={ "#field-" + name }
			hx-swap="outerHTML"
		>
			Edit    
		</button>
	</div>
}

templ EditableInfoField(name string, typeStr string, value string) {
	<div id={ "field-" + name }>
		<input
			type={ typeStr }
			name={ name }
			value={ value }
			style="background-color: var(--white80);"
		/>
	</div>
}

templ EditPasswordSection() {
	<div id="edit-password-section">
		<div id="password-inputs">
			<input type="password" name="current-password" placeholder="Current password" style="width: 100%;"/>
			<input type="password" name="new-password" placeholder="New password" style="width: 100%;"/>
			<input type="password" name="repeat-password" placeholder="Repeat new password" style="width: 100%;"/>
		</div>
		<div id="password-button">
			<button
				type="button"
				class="scifi-button"
				hx-get="/settings/edit/password/cancel"
				hx-target="#edit-password-section"
				hx-swap="outerHTML"
			>
				Cancel    
			</button>
		</div>
	</div>
}

templ AvatarSettings(user utils.User) {
	<div id="avatar-section">
		if user.AvatarURLValid {
			<img
				id="avatar-preview"
				class="avatar-img"
				src={ user.AvatarURLString + "?v=" + fmt.Sprint(time.Now().Unix()) }
				alt="User avatar"
			/>
		} else {
			<img
				id="avatar-preview"
				class="avatar-img"
				src="static/img/default-avatar.jpg"
				alt="User avatar"
			/>
		}
	</div>
	<div id="edit-avatar">
		<button 
			type="button" 
			class="scifi-button" 
			hx-get="/settings/modify-avatar" 
			hx-target="#edit-avatar" 
			hx-swap="innerHTML"
		>
			Modify 
		</button>
	</div>
}

templ AvatarOptions() {
	<input 
		type="file" 
		id="avatar" 
		name="avatar" 
		accept="image/*" 
		hidden
		hx-on="change:
			const file = this.files[0];
			if (file) {
				document.getElementById('avatar-preview').src = URL.createObjectURL(file);
			}"
	/>
	<label for="avatar" class="scifi-button" id="upload-avatar" style="user-select: none;"> Upload new avatar </label>

	<input 
		type="hidden"
		id="delete-avatar-flag"
		name="delete-avatar"
		value="false"
	/>
	<button 
		type="button"
		class="scifi-button" 
		hx-on="click:
			document.getElementById('delete-avatar-flag').value='true';
			document.getElementById('avatar-preview').src='static/img/default-avatar.jpg';"
	> 
		Delete avatar 
	</button>
	
}

templ PreferenceItem(preference string) {
	<div class="preference">
		<button type="button" class="remove-preference" onclick="this.parentElement.remove()" />
		<input
			type="text"
			name="preferences[]"
			value={ preference }
			readonly
			tabindex="-1"
		/>
	</div>
}

templ SettingsPage(user utils.User, preferences []string, translator utils.Translator) {
	@Layout("Settings", translator, func() templ.Component {
		return settingsContent(user, preferences)
	})
}